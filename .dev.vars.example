# ==============================================================================
# Cloudflare Workers Local Secrets (.dev.vars.example)
# Copy to .dev.vars for local Wrangler/Miniflare Worker previews (never commit)
# ==============================================================================

SESSION_SECRET=dev_session_secret_at_least_32_characters_long_for_signing
COOKIE_SECURE=false
# Use MOCK in local tests, or OGENSYNC with your live API key from https://transport.ogensync.com
WHATSAPP_PROVIDER=MOCK
OGENSYNC_BASE_URL=https://transport.ogensync.com
WHATSAPP_API_KEY=mock_whatsapp_key

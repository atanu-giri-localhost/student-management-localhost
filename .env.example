# ==============================================================================
# Student Management System (SMS) — Local Environment Example
# Copy to .env.local for local development (never commit .env.local or secrets)
# ==============================================================================

# Application & Runtime
NODE_ENV=development
APP_NAME="Apex Student Management System"
NEXT_PUBLIC_INSTITUTE_NAME="Apex Coaching Institute"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session & Security (generate production value with: openssl rand -base64 32)
SESSION_SECRET="dev_session_secret_at_least_32_characters_long_for_signing"
COOKIE_SECURE=false
COOKIE_NAME="sms_session"

# WhatsApp OTP Configuration (MOCK logs OTP to server console in local dev)
WHATSAPP_PROVIDER="MOCK"
WHATSAPP_API_KEY="mock_whatsapp_key"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_id"
WHATSAPP_TEMPLATE_NAME="sms_auth_otp"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Cloudflare Local D1 (managed in .wrangler/state/v3/d1)
D1_DATABASE_NAME="sms-coaching-d1"
